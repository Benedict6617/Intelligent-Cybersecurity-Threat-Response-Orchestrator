# Copy this file to .env and fill in real values before deploying.
# Nothing in this file is a real secret - all values are placeholders.

APP_NAME="Intelligent Cybersecurity Threat Response Orchestrator"
APP_ENV=development
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://orchestrator:password@localhost:5432/orchestrator
DATABASE_URL=sqlite:///./data/orchestrator.db

CORRELATION_WINDOW_MINUTES=15
ANOMALY_CONTAMINATION=0.03
FALSE_POSITIVE_CONFIDENCE_THRESHOLD=0.65
AUTO_CONTAINMENT_MIN_SEVERITY=high

ITSM_PROVIDER=generic
ITSM_BASE_URL=https://itsm.example-corp.local/api
ITSM_API_TOKEN=replace-with-real-token
ITSM_DEFAULT_QUEUE=SOC-L1

THREAT_INTEL_FEED_URLS=https://otx.alienvault.com/api/v1/pulses/subscribed
THREAT_INTEL_REFRESH_MINUTES=30

SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
ALERT_EMAIL_FROM=soc-alerts@example-corp.local

COMPLIANCE_FRAMEWORKS=SOC2,ISO27001
ORGANIZATION_NAME=Example Corp
